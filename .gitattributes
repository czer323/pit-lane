# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Explicitly declare text files
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.md text
*.yml text
*.yaml text

# Denote binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfiles are generated — don't normalize line endings
pnpm-lock.yaml -text
