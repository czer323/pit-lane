{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Pit Lane Design System",
  "version": "0.1.0",
  "description": "Design tokens for Pit Lane — drag racing pit sheet app",
  "color": {
    "background": {
      "base": {
        "value": "#0d0d0d",
        "type": "color",
        "description": "Page/body background — near-black"
      },
      "surface": {
        "value": "#161616",
        "type": "color",
        "description": "Card, chip, modal background"
      },
      "surface-active": {
        "value": "#1e1a0a",
        "type": "color",
        "description": "Active/selected surface — warm dark"
      },
      "surface-hover": {
        "value": "#1e1e1e",
        "type": "color",
        "description": "Hover state surface"
      },
      "surface-input": {
        "value": "#0d0d0d",
        "type": "color",
        "description": "Input field background"
      },
      "overlay": {
        "value": "rgba(0, 0, 0, 0.75)",
        "type": "color",
        "description": "Modal overlay backdrop"
      }
    },
    "border": {
      "default": {
        "value": "#2a2a2a",
        "type": "color",
        "description": "Standard border — cards, chips, inputs"
      },
      "subtle": {
        "value": "#1e1e1e",
        "type": "color",
        "description": "Subtle divider — row separators"
      },
      "strong": {
        "value": "#333333",
        "type": "color",
        "description": "Stronger border — buttons, groups"
      },
      "focus": { "value": "#f9a825", "type": "color", "description": "Focus ring / active border" }
    },
    "accent": {
      "primary": {
        "value": "#f9a825",
        "type": "color",
        "description": "Brand accent — buttons, active states, primary data"
      },
      "primary-hover": {
        "value": "#d48a1a",
        "type": "color",
        "description": "Accent hover/pressed state"
      },
      "primary-muted": {
        "value": "rgba(249, 168, 37, 0.27)",
        "type": "color",
        "description": "Accent with alpha — button borders, subtle highlights"
      }
    },
    "lane": {
      "left": { "value": "#ab47bc", "type": "color", "description": "Left lane — purple" },
      "left-bg": {
        "value": "#1e0d22",
        "type": "color",
        "description": "Left lane active background"
      },
      "right": { "value": "#ef5350", "type": "color", "description": "Right lane — red" },
      "right-bg": {
        "value": "#2a0d0d",
        "type": "color",
        "description": "Right lane active background"
      }
    },
    "status": {
      "win": { "value": "#2e7d32", "type": "color", "description": "Win border/text" },
      "win-bg": { "value": "#1b5e20", "type": "color", "description": "Win active background" },
      "win-text": { "value": "#a5d6a7", "type": "color", "description": "Win text — light green" },
      "loss": { "value": "#c62828", "type": "color", "description": "Loss border/text" },
      "loss-bg": { "value": "#b71c1c", "type": "color", "description": "Loss active background" },
      "loss-text": { "value": "#ef9a9a", "type": "color", "description": "Loss text — light red" },
      "elim": {
        "value": "#66bb6a",
        "type": "color",
        "description": "Elimination selected — green"
      },
      "elim-text": {
        "value": "#a5d6a7",
        "type": "color",
        "description": "Elimination text — light green"
      },
      "breakout": {
        "value": "#fdd835",
        "type": "color",
        "description": "Breakout indicator — yellow"
      },
      "red-light": { "value": "#e53935", "type": "color", "description": "Red light / foul" },
      "anomaly": {
        "value": "#ff8f00",
        "type": "color",
        "description": "Anomaly detection — orange"
      }
    },
    "text": {
      "primary": { "value": "#cccccc", "type": "color", "description": "Body text — default" },
      "strong": { "value": "#dddddd", "type": "color", "description": "Strong emphasis text" },
      "bright": {
        "value": "#ffffff",
        "type": "color",
        "description": "Bright text — inputs, highlights"
      },
      "muted": {
        "value": "#555555",
        "type": "color",
        "description": "Muted text — labels, captions"
      },
      "subtle": {
        "value": "#444444",
        "type": "color",
        "description": "Subtle text — inactive labels"
      },
      "faint": {
        "value": "#2a2a2a",
        "type": "color",
        "description": "Faint text — hints, placeholders border"
      },
      "on-accent": {
        "value": "#0d0d0d",
        "type": "color",
        "description": "Text on accent-colored backgrounds"
      },
      "disabled": { "value": "#555555", "type": "color", "description": "Disabled button text" }
    }
  },
  "typography": {
    "family": {
      "sans": {
        "value": "\"Segoe UI\", system-ui, sans-serif",
        "type": "fontFamily",
        "description": "Primary typeface — system stack"
      },
      "mono": {
        "value": "\"Courier New\", monospace",
        "type": "fontFamily",
        "description": "Monospace — timing data, numeric inputs"
      }
    },
    "size": {
      "xs": {
        "value": "0.35rem",
        "type": "dimension",
        "description": "Tiny — dial labels, micro text"
      },
      "sm": {
        "value": "0.5rem",
        "type": "dimension",
        "description": "Small — captions, secondary labels"
      },
      "base": {
        "value": "0.65rem",
        "type": "dimension",
        "description": "Base — labels, body text"
      },
      "md": {
        "value": "0.75rem",
        "type": "dimension",
        "description": "Medium — notes, secondary content"
      },
      "lg": {
        "value": "0.85rem",
        "type": "dimension",
        "description": "Large — input text, primary content"
      },
      "xl": {
        "value": "0.95rem",
        "type": "dimension",
        "description": "XL — large data display (temperature)"
      }
    },
    "weight": {
      "regular": { "value": "400", "type": "fontWeight" },
      "medium": { "value": "500", "type": "fontWeight" },
      "semibold": { "value": "600", "type": "fontWeight" },
      "bold": { "value": "700", "type": "fontWeight" }
    },
    "transform": {
      "uppercase": {
        "value": "uppercase",
        "type": "textTransform",
        "description": "Labels, section headers"
      }
    },
    "tracking": {
      "wide": { "value": "0.04em", "type": "letterSpacing", "description": "Label tracking" },
      "wider": {
        "value": "0.05em",
        "type": "letterSpacing",
        "description": "Tab bar, section headers"
      },
      "widest": { "value": "0.06em", "type": "letterSpacing", "description": "Micro labels" }
    }
  },
  "spacing": {
    "0": { "value": "0", "type": "dimension" },
    "1": {
      "value": "0.05rem",
      "type": "dimension",
      "description": "Tightest — internal chip gaps"
    },
    "2": { "value": "0.08rem", "type": "dimension", "description": "Tight — chip label/data gap" },
    "3": {
      "value": "0.1rem",
      "type": "dimension",
      "description": "Compact — grid gaps, button gaps"
    },
    "4": { "value": "0.15rem", "type": "dimension", "description": "Small — internal padding" },
    "5": {
      "value": "0.2rem",
      "type": "dimension",
      "description": "Default — row gaps, small padding"
    },
    "6": {
      "value": "0.25rem",
      "type": "dimension",
      "description": "Medium — card internal spacing"
    },
    "7": {
      "value": "0.3rem",
      "type": "dimension",
      "description": "Comfortable — chip padding, section gaps"
    },
    "8": { "value": "0.35rem", "type": "dimension", "description": "Relaxed — grid gaps" },
    "9": {
      "value": "0.4rem",
      "type": "dimension",
      "description": "Spacious — modal padding, button gaps"
    },
    "10": { "value": "0.45rem", "type": "dimension", "description": "Large — input padding" },
    "11": { "value": "0.6rem", "type": "dimension", "description": "XL — section gaps" },
    "12": { "value": "0.7rem", "type": "dimension", "description": "2XL — card padding" },
    "13": { "value": "1rem", "type": "dimension", "description": "3XL — page padding" }
  },
  "borderRadius": {
    "sm": { "value": "2px", "type": "dimension", "description": "Tight — dial adjust buttons" },
    "md": {
      "value": "4px",
      "type": "dimension",
      "description": "Default — small buttons, filter chips"
    },
    "lg": { "value": "5px", "type": "dimension", "description": "Medium — inputs, thumbnails" },
    "xl": {
      "value": "6px",
      "type": "dimension",
      "description": "Large — toggle buttons, env groups"
    },
    "2xl": {
      "value": "8px",
      "type": "dimension",
      "description": "XL — cards, chips, primary button"
    },
    "3xl": { "value": "10px", "type": "dimension", "description": "2XL — entry card" },
    "4xl": { "value": "12px", "type": "dimension", "description": "3XL — modals" },
    "pill": { "value": "9999px", "type": "dimension", "description": "Pill shape — full rounding" }
  },
  "shadow": {
    "none": { "value": "none", "type": "shadow" },
    "sm": { "value": "0 1px 2px rgba(0,0,0,0.3)", "type": "shadow", "description": "Subtle lift" },
    "md": {
      "value": "0 2px 8px rgba(0,0,0,0.4)",
      "type": "shadow",
      "description": "Card elevation"
    },
    "lg": {
      "value": "0 4px 16px rgba(0,0,0,0.5)",
      "type": "shadow",
      "description": "Modal elevation"
    }
  },
  "layout": {
    "max-width": {
      "value": "560px",
      "type": "dimension",
      "description": "Mobile max content width"
    },
    "row-height": { "value": "55px", "type": "dimension", "description": "Fixed top row height" },
    "thumbnail-size": { "value": "32px", "type": "dimension", "description": "Car thumbnail" },
    "env-button-size": {
      "value": "22px",
      "type": "dimension",
      "description": "Environment +/- buttons"
    }
  }
}
